{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user", "gm"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Character": {
      "title": "Character",
      "description": "RPG character data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "sessionId": { "type": "string" },
        "name": { "type": "string" },
        "class": { "type": "string" },
        "level": { "type": "integer" },
        "xp": { "type": "integer" },
        "xpMax": { "type": "integer" },
        "image": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "for": { "type": "integer" },
            "con": { "type": "integer" },
            "agi": { "type": "integer" },
            "per": { "type": "integer" },
            "vel": { "type": "integer" },
            "ini": { "type": "integer" },
            "int": { "type": "integer" },
            "cor": { "type": "integer" }
          }
        },
        "statsMods": {
          "type": "object",
          "properties": {
            "for": { "type": "integer" },
            "con": { "type": "integer" },
            "agi": { "type": "integer" },
            "per": { "type": "integer" },
            "vel": { "type": "integer" },
            "ini": { "type": "integer" },
            "int": { "type": "integer" },
            "cor": { "type": "integer" }
          }
        },
        "canEditStats": { "type": "boolean" },
        "talentMods": {
          "type": "object",
          "description": "Map of talentId to modifier value"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of skill IDs assigned to the character"
        },
        "powers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of power IDs assigned to the character"
        },
        "traits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of trait IDs assigned to the character"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "class", "level", "stats"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "RPG session journal entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "gameSessionId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string" },
        "xp": { "type": "integer" },
        "content": { "type": "string" },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": { "type": "string" },
              "event": { "type": "string" },
              "type": { "type": "string" },
              "status": { "type": "string", "enum": ["completed", "current", "upcoming"] }
            }
          }
        },
        "npcs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "status": { "type": "string" },
              "image": { "type": "string" }
            }
          }
        },
        "gallery": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "date"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "A multi-player RPG session managed by a GM",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gmId": { "type": "string" },
        "playerIds": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "maxAttributePoints": { "type": "integer" },
        "initialSkillPoints": { "type": "integer" },
        "initialPowerPoints": { "type": "integer" },
        "description": { "type": "string" },
        "active": { "type": "boolean" },
        "shopEnabled": { "type": "boolean", "description": "Whether the shop is visible to players" },
        "shopItemIds": { 
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of items from CatalogItem that are available in the shop"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gmId", "name", "code"]
    },
    "Talent": {
      "title": "Talent",
      "description": "A talent or skill that can be assigned to characters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "composition": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of attribute IDs that compose this talent"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "composition"]
    },
    "Skill": {
      "title": "Skill",
      "description": "A skill that can be assigned to characters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Luta", "Mística", "Geral", "Conhecimento", "Artes", "Treinamento", "Ocultismo", "Empírico"] },
        "atpCost": { "type": "integer" },
        "damage": { "type": "string" },
        "description": { "type": "string" },
        "purchaseCost": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "purchaseCost"]
    },
    "Power": {
      "title": "Power",
      "description": "A power or spell that can be assigned to characters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Físico", "Elemental", "Defesa", "Buff", "Debuff", "Geral"] },
        "cost": { "type": "string" },
        "effect": { "type": "string" },
        "description": { "type": "string" },
        "purchaseCost": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "purchaseCost"]
    },
    "GlobalSettings": {
      "title": "GlobalSettings",
      "description": "Global RPG system settings and formulas",
      "type": "object",
      "properties": {
        "maxAttributePoints": { "type": "integer" },
        "maxSingleAttributeValue": { "type": "integer" },
        "initialSkillPoints": { "type": "integer" },
        "initialPowerPoints": { "type": "integer" },
        "pvFormula": { "type": "string" },
        "atpFormula": { "type": "string" },
        "socoFormula": { "type": "string" },
        "chuteFormula": { "type": "string" },
        "defesaFormula": { "type": "string" },
        "esquivaFormula": { "type": "string" },
        "enFormula": { "type": "string" },
        "dmFormula": { "type": "string" },
        "skillCostFormula": { "type": "string" },
        "powerCostFormula": { "type": "string" },
        "skillTypeVars": { "type": "object" },
        "powerTypeVars": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Suggestion": {
      "title": "Suggestion",
      "description": "Player suggestion for a new skill, power, or trait",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["skill", "power", "trait"] },
        "data": { "type": "object" },
        "suggestedBy": { "type": "string" },
        "suggestedByName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "data", "suggestedBy", "status"]
    },
    "Trait": {
      "title": "Trait",
      "description": "Advantages and Disadvantages (Vantagens e Defeitos)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "effect": { "type": "string" },
        "modifier": { "type": "integer" },
        "modifierType": { "type": "string" },
        "type": { "type": "string", "enum": ["advantage", "disadvantage"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message in a session chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "text": { "type": "string" },
        "image": { "type": "string" },
        "type": { "type": "string" },
        "rollData": { "type": "object" },
        "shouldNotify": { "type": "boolean", "description": "Whether this message should trigger a notification" },
        "mentionedUserIds": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of user IDs mentioned in this message"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "senderId", "senderName", "createdAt"]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Item saved in the global catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "rarity": { "type": "string" },
        "weight": { "type": "number" },
        "value": { "type": "integer" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "stats": { "type": "object" },
        "damage": { "type": "string" },
        "defense": { "type": "integer" },
        "createdBy": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category"]
    },
    "MapPin": {
      "title": "MapPin",
      "description": "Coordinate-based pins on world map for play sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "mapId": { "type": "string" },
        "sessionId": { "type": "string" },
        "sessionName": { "type": "string" },
        "category": { "type": "string" },
        "customIcon": { "type": "string" },
        "dangerLevel": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "isSecret": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "x", "y", "createdBy"]
    },
    "DungeonToken": {
      "title": "DungeonToken",
      "description": "Tactical token placed on a dungeon battlemap by players or the GM",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dungeonId": { "type": "string" },
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "characterId": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "gridX": { "type": "number" },
        "gridY": { "type": "number" },
        "color": { "type": "string" },
        "type": { "type": "string" },
        "hp": { "type": "number" },
        "maxHp": { "type": "number" },
        "size": { "type": "number" },
        "elevation": { "type": "number" },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "isVisible": { "type": "boolean" },
        "lastMovedAt": { "type": "string", "format": "date-time" },
        "lastMovedBy": { "type": "string" }
      },
      "required": ["dungeonId", "name", "x", "y"]
    },
    "DungeonMap": {
      "title": "DungeonMap",
      "description": "Dungeon battlemap configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "gridSize": { "type": "number" },
        "gridColumns": { "type": "number" },
        "gridRows": { "type": "number" },
        "fogOfWar": { "type": "boolean" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "imageUrl"]
    },
    "DungeonFog": {
      "title": "DungeonFog",
      "description": "Persistent Fog of War data for dungeon battlemaps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dungeonId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "revealedCells": { "type": "array", "items": { "type": "number" } },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["dungeonId", "enabled"]
    },
    "DungeonAoE": {
      "title": "DungeonAoE",
      "description": "Area of effect spell templates on dungeon battlemap",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dungeonId": { "type": "string" },
        "sessionId": { "type": "string" },
        "type": { "type": "string", "enum": ["circle", "cone", "line", "cube"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "radiusFeet": { "type": "number" },
        "color": { "type": "string" },
        "name": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["dungeonId", "type", "x", "y", "radiusFeet", "color"]
    },
    "DungeonMarker": {
      "title": "DungeonMarker",
      "description": "Tactical markers placed on dungeon battlemaps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mapId": { "type": "string" },
        "sessionId": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "label": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["mapId", "x", "y", "label", "category"]
    },
    "DungeonAtmosphere": {
      "title": "DungeonAtmosphere",
      "description": "Atmospheric soundscape and weather state for dungeon battlemaps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dungeonId": { "type": "string" },
        "sessionId": { "type": "string" },
        "soundscape": { "type": "string" },
        "weather": { "type": "string" },
        "volume": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["dungeonId"]
    },
    "CustomSound": {
      "title": "CustomSound",
      "description": "Custom sound effect or ambient audio uploaded or linked by the GM",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "sourceType": { "type": "string" },
        "url": { "type": "string" },
        "size": { "type": "number" },
        "format": { "type": "string" },
        "sessionId": { "type": "string" },
        "sessionName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "systemSoundKey": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "url", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/characters/{characterId}": {
      "schema": "Character",
      "description": "Characters created by users"
    },
    "/journalEntries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Session journal entries"
    },
    "/gameSessions/{sessionId}": {
      "schema": "GameSession",
      "description": "Multi-player game sessions"
    },
    "/talents/{talentId}": {
      "schema": "Talent",
      "description": "Global talents"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Global skills"
    },
    "/powers/{powerId}": {
      "schema": "Power",
      "description": "Global powers and spells"
    },
    "/globalSettings/config": {
      "schema": "GlobalSettings",
      "description": "Global system configuration"
    },
    "/suggestions/{suggestionId}": {
      "schema": "Suggestion",
      "description": "Player suggestions for skills or powers"
    },
    "/traits/{traitId}": {
      "schema": "Trait",
      "description": "Global advantages and disadvantages"
    },
    "/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages for game session chats"
    },
    "/itemCatalog/{itemId}": {
      "schema": "CatalogItem",
      "description": "Global catalog of items created by players"
    },
    "/mapPins/{pinId}": {
      "schema": "MapPin",
      "description": "Coordinate-based pins on world map for play sessions"
    },
    "/dungeonTokens/{tokenId}": {
      "schema": "DungeonToken",
      "description": "Tokens positioned on dungeon battlemaps synced in real time"
    },
    "/dungeonMaps/{mapId}": {
      "schema": "DungeonMap",
      "description": "Dungeon battlemaps"
    },
    "/dungeonFog/{fogId}": {
      "schema": "DungeonFog",
      "description": "Persistent Fog of War state for dungeon battlemaps"
    },
    "/dungeonAoEs/{aoeId}": {
      "schema": "DungeonAoE",
      "description": "Area of effect spell templates on dungeon battlemaps"
    },
    "/dungeonMarkers/{markerId}": {
      "schema": "DungeonMarker",
      "description": "Tactical markers placed on dungeon battlemaps"
    },
    "/dungeonAtmosphere/{dungeonId}": {
      "schema": "DungeonAtmosphere",
      "description": "Atmospheric soundscapes and visual weather for battlemaps"
    },
    "/customSounds/{soundId}": {
      "schema": "CustomSound",
      "description": "Custom sound effects and ambient tracks uploaded or linked by the GM"
    }
  }
}
